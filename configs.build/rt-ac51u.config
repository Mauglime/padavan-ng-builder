CONFIG_VENDOR_ASUS=y
CONFIG_PRODUCT=MT7620
CONFIG_FIRMWARE_PRODUCT_ID="RT-AC51U"
CONFIG_FIRMWARE_ENABLE_IPV6=y
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_NFS=n
CONFIG_FIRMWARE_ENABLE_SUDO=n
CONFIG_FIRMWARE_INCLUDE_ZAPRET=y
CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y
CONFIG_FIRMWARE_INCLUDE_OPENSSHD=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_HTOP=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL=y

